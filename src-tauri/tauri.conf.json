{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "SportsScoreboard",
  "version": "0.1.0",
  "identifier": "com.ryan.sportsscoreboard",
  "build": {
    "frontendDist": "../SportsScoreboard/dist",
    "devUrl": "http://localhost:8000",
    "beforeDevCommand": "npm --prefix SportsScoreboard run serve",
    "beforeBuildCommand": "npm --prefix SportsScoreboard run build"
  },
  "app": {
    "windows": [
      {
        "title": "Sports Scoreboard",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
