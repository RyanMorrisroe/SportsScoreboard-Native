{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Baseline Tauri core permissions for the main window; the app registers an allowlisted ESPN command and grants no filesystem or shell access.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "https://github.com/RyanMorrisroe/SportsScoreboard-Native/releases/download/*/*.apk"
        },
        {
          "url": "https://github.com/RyanMorrisroe/SportsScoreboard-Native/releases/download/*/*-setup.exe"
        }
      ]
    }
  ]
}
